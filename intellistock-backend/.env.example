# IntelliStock Backend Configuration Template
# Set environment variables in your deployment setup or use local environment variables

# Optional External API Keys (Mocks will fall back if keys are missing or invalid)
GEMINI_API_KEY=your_gemini_api_key_here
FINNHUB_API_KEY=your_finnhub_api_key_here
FMP_API_KEY=your_fmp_api_key_here
NEWS_API_KEY=your_newsapi_key_here
ALPHA_VANTAGE_API_KEY=your_alphavantage_key_here
TWELVE_DATA_API_KEY=your_twelvedata_key_here
POLYGON_API_KEY=your_polygon_key_here

# Redis Configuration (Optional, falls back to local in-memory caching if connection fails)
# REDIS_HOST=localhost
# REDIS_PORT=6379

# Allowed CORS Origins (Comma-separated allowed client endpoints)
CORS_ALLOWED_ORIGINS=http://localhost:5173
